		"jsdom": "30.0.1",
		"oxfmt": "0.68.0",
		"oxlint": "1.83.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1"
	}
