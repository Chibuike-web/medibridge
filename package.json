{
	"name": "medibridge",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev -p 4300",
		"build": "next build",
		"start": "next start -p 4300",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "vitest",
		"test:run": "vitest run",
		"devtools": "npx @ai-sdk/devtools",
		"db:generate": "drizzle-kit generate --config=./src/lib/drizzle.config.ts",
		"db:push": "drizzle-kit push --config=./src/lib/drizzle.config.ts",
		"db:studio": "drizzle-kit studio --config=./src/lib/drizzle.config.ts --port=4000",
		"db:migrate": "drizzle-kit migrate --config=./src/lib/drizzle.config.ts",
		"db:seed": "bun run src/db/run-table-seeds.ts",
		"db:seed-shared-record": "bun run src/db/seed-shared-record.ts",
		"db:sync-hospitals": "bun run src/db/sync-hospitals.ts",
		"db:approve-hospital": "bun run src/db/approve-hospital.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@hookform/resolvers": "^5.9.1",
		"@radix-ui/react-avatar": "^1.2.6",
		"@radix-ui/react-checkbox": "^1.3.11",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-label": "^2.1.15",
		"@radix-ui/react-popover": "^1.1.23",
		"@radix-ui/react-select": "^2.3.7",
		"@radix-ui/react-slot": "^1.3.3",
		"@react-pdf/renderer": "^4.9.0",
		"@remixicon/react": "^4.9.0",
		"@supabase/supabase-js": "^2.116.0",
		"@tanstack/react-table": "^9.2.4",
		"ai": "7.0.130",
		"babel-plugin-react-compiler": "^1.0.0",
		"bcrypt": "^6.0.0",
		"better-auth": "^1.7.5",
		"class-variance-authority": "^0.7.1",
		"cmdk": "^1.1.1",
		"cn": "^0.3.0",
		"date-fns": "^4.4.0",
		"dotenv": "^18.0.1",
		"drizzle-orm": "^0.45.2",
		"input-otp": "^1.5.0",
		"jose": "^6.2.12",
		"mammoth": "^1.12.3",
		"motion": "^13.4.0",
		"next": "16.4.0",
		"pdf-lib": "^1.17.1",
		"postgres": "^3.4.9",
		"radix-ui": "^1.6.7",
		"react": "19.3.0",
		"react-day-picker": "^10.0.1",
		"react-dom": "19.3.0",
		"react-hook-form": "^7.88.0",
		"recharts": "^3.10.1",
		"resend": "^6.28.1",
		"swr": "^2.5.1",
		"vaul": "^1.1.2",
		"zod": "^4.6.5",
		"zustand": "^5.0.15"
	},
	"devDependencies": {
		"@ai-sdk/devtools": "1.0.33",
		"@tailwindcss/postcss": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/bcrypt": "^6.0.0",
		"@types/node": "^26.6.2",
		"@types/pg": "^8.23.1",
